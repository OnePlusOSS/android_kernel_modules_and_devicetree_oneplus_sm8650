&oplus_cpa {
	oplus,protocol_list = <CHG_PROTOCOL_VOOC 80
				CHG_PROTOCOL_PPS  55
				CHG_PROTOCOL_PD   18
				CHG_PROTOCOL_QC   18>;
	oplus,default_protocol_list = <CHG_PROTOCOL_VOOC
				CHG_PROTOCOL_PPS
				CHG_PROTOCOL_PD>;
};

&oplus_monitor {
	track,nominal_qmax1 = <8191>;
	track,nominal_fcc1 = <7705>;
};

&oplus_virtual_gauge {
	oplus,batt_capacity_mah = <8000>;
};

