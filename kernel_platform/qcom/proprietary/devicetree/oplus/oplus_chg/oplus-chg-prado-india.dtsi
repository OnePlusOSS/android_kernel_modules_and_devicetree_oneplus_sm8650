				4510 4500 /* 0 ~ 5 */
				4510 4500 /* 5 ~ 12 */
				4560 4550 /* 12 ~ 16 */
				4560 4550 /* 16 ~ 20 */
				4560 4550 /* 20 ~ 35 */
				4560 4550 /* 35 ~ 44 */
				4140 4130 /* 44 ~ 51 */
				>;

	ocp_reg = <0xe>;
